{
    "compilerOptions": {
        "jsx": "react-jsx",
        "esModuleInterop": true,
        "isolatedModules": true,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "target": "es2018",
        "noImplicitAny": true,
        "allowSyntheticDefaultImports": true,
        "skipLibCheck": true,
        "lib": ["dom", "es2018"],
        "baseUrl": ".",
        "paths": {
            "main": ["src/main.ts"],
            "modals": ["src/modals.ts"],
            "settings": ["src/settings.ts"],
            "FileTreeView": ["src/FileTreeView.tsx"],
            "utils/*": ["src/utils/*"],
            "components/*": ["src/components/*"],
            "hooks/*": ["src/hooks/*"],
            "recoil/*": ["src/recoil/*"]
        }
    },
    "include": ["**/*.ts", "**/*.tsx", "src/FileTreeView.tsx"]
}
